{
  "name": "notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#acryl-db-sqlite": "./plugins/db-sqlite/src/index.ts",
    "#acryl-db": "./plugins/db/src/index.ts",
    "#acryl-db/conformance": "./plugins/db/src/conformance.ts",
    "#acryl-jsx/jsx-runtime": "./plugins/router/src/core/jsx/jsx-runtime.ts",
    "#acryl-jsx/jsx-dev-runtime": "./plugins/router/src/core/jsx/jsx-dev-runtime.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "acryl": "node plugins/door/src/cli/acryl.ts",
    "start": "node --import ./plugins/node-server/src/register.ts src/main.ts",
    "dev": "node --watch --import ./plugins/node-server/src/register.ts src/main.ts",
    "test": "acrylblends check-deps && node --import ./plugins/node-server/src/register.ts --test \"test/**/*.test.{ts,tsx}\"",
    "check": "tsc --noEmit && tsc --noEmit -p src/client && acrylblends check-deps",
    "build": "acrylblends build-client",
    "lock": "node plugins/manifest/lock.ts",
    "snapshot": "node plugins/manifest/snapshot.ts",
    "save": "node plugins/save/cli.ts",
    "share": "node plugins/save/share-cli.ts",
    "upgrade": "node plugins/manifest/upgrade-cli.ts",
    "predev": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "pretest": "node scripts/check-node.cjs",
    "precheck": "node scripts/check-node.cjs"
  },
  "dependencies": {
    "@acryldev/app-persistence": "0.1.3",
    "@acryldev/blends": "^1.7.4",
    "@acryldev/blends-core": "0.6.0",
    "@acryldev/instance": "0.1.2",
    "@acryldev/plugin-hub-core": "0.2.2",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ws": "8.21.3"
  },
  "acryl": {
    "opener": "src/app.ts"
  }
}
