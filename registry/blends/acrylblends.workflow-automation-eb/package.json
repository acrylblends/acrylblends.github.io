{
  "name": "workflow-automation-eb",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "imports": {
    "#acryl-jsx/jsx-runtime": "./plugins/router/src/core/jsx/jsx-runtime.ts",
    "#acryl-jsx/jsx-dev-runtime": "./plugins/router/src/core/jsx/jsx-dev-runtime.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "desktop": "acryl-desktop",
    "acryl": "node plugins/door/src/cli/acryl.ts",
    "save": "node plugins/save/cli.ts",
    "share": "node plugins/save/share-cli.ts",
    "start": "node --import ./plugins/node-server/src/register.ts src/main.ts",
    "dev": "node --import ./plugins/node-server/src/register.ts scripts/ide-host.mjs",
    "test": "node --import ./plugins/node-server/src/register.ts --test \"test/**/*.test.{ts,tsx}\"",
    "check": "tsc --noEmit && tsc --noEmit -p plugins/automation-studio/client",
    "lock": "node plugins/manifest/lock.ts",
    "snapshot": "node plugins/manifest/snapshot.ts",
    "upgrade": "node plugins/manifest/upgrade-cli.ts",
    "predev": "node scripts/check-node.cjs",
    "prestart": "node scripts/check-node.cjs",
    "pretest": "node scripts/check-node.cjs",
    "precheck": "node scripts/check-node.cjs",
    "build:studio": "node scripts/build-studio.mjs",
    "pack:electrobun": "node electrobun/pack.mjs"
  },
  "dependencies": {
    "@acryldev/app-context": "^0.2.1",
