    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-base": "0.2.0-rc.2",
    "@deepseek-ai/dsh-web-app": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "croner": "^9.1.0",
    "dayjs": "^1.11.23",
    "js-yaml": "^4.2.0",
    "skill-mcp-manager": "^1.3.1",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
